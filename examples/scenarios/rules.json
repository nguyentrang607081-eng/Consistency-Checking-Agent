{
  "schema_version": "1.0",
  "default_policy": "design_only",
  "layers": [
    {"name": "presentation", "components": ["api"]},
    {"name": "application", "components": ["services"]},
    {"name": "infrastructure", "components": ["repositories", "notifications"]},
    {"name": "domain", "components": ["models"]}
