# Sao chép thành .env (cần python-dotenv) hoặc đặt biến môi trường trực tiếp.
# Mặc định CCA KHÔNG cần API key: review chạy bằng RAG + few-shot cục bộ (CCA_LLM_PROVIDER=local).

# Đường dẫn SQLite của Knowledge (MAPE-K)
CCA_KB_PATH=data/cca_knowledge.sqlite
# Ngưỡng confidence để finding được "confirmed" (đồng bộ Coordinator: 0.7)
CCA_CONFIDENCE_THRESHOLD=0.7
# Ngưỡng chấp nhận ánh xạ component tự động
CCA_MAPPING_ACCEPT=0.75
# Số module code để coi là "đồ thị lớn" (bật quét incremental)
CCA_LARGE_MODULES=300

# ---- RAG + few-shot + LLM review (tùy chọn) ----
# none | local (mặc định, offline) | groq | ollama | openai | openai_compat
CCA_LLM_PROVIDER=local
# Groq (cùng key với Architecture Extraction Agent, có gói miễn phí):
# CCA_LLM_PROVIDER=groq
# GROQ_API_KEY=
# Ollama chạy model mở trên máy (miễn phí, không cần key): ollama pull qwen2.5:7b-instruct
# CCA_LLM_PROVIDER=ollama
# CCA_LLM_MODEL=qwen2.5:7b-instruct
# Endpoint tương thích OpenAI bất kỳ:
# CCA_LLM_BASE_URL=http://localhost:8000/v1
# CCA_LLM_API_KEY=
# advisory: LLM chỉ góp ý | resolve: LLM được nâng finding "needs_review" -> "confirmed"
CCA_LLM_POLICY=advisory
# Ngân sách số lần gọi LLM mỗi lần quét
CCA_LLM_MAX_CALLS=20
CCA_LLM_TIMEOUT=30
